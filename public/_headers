# Static asset caching intentionally uses Cloudflare Pages defaults.
# Do not add long-lived `immutable` caching to mutable CSS/JS filenames such as
# /assets/css/app.css or /assets/js/posts.js. Pages already provides CDN caching,
# ETag revalidation, Brotli/Gzip, and refreshes deployed assets on new deployments.

/admin/*
  X-Robots-Tag: noindex, nofollow

/add.html
  X-Robots-Tag: noindex, nofollow

/edit.html
  X-Robots-Tag: noindex, nofollow

/api/admin/*
  X-Robots-Tag: noindex, nofollow

/ads.txt
  Content-Type: text/plain; charset=utf-8
  X-Robots-Tag: all
